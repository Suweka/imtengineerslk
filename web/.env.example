# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="random-secret-key-min-32-chars"
NEXTAUTH_URL="https://imtengineers.lk"

# Cloudinary (Image Storage & Background Removal)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# remove.bg (Background Removal API)
REMOVE_BG_API_KEY="your_remove_bg_api_key"

# WhatsApp Business Cloud API (Optional - for WhatsApp notifications)
WHATSAPP_API_TOKEN="your_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"
IMT_NOTIFY_NUMBER="94766644460"
WHATSAPP_ORDER_TEMPLATE="order_confirmation"
WHATSAPP_SERVICE_TEMPLATE="service_request_confirmation"

# Cloudflare R2 (Optional - for future S3-compatible storage)
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="imt-product-images"
R2_PUBLIC_URL="https://your-bucket.com"
